# Keycard issuer URL: https://<zone-id>.keycard.cloud
KEYCARD_ISSUER=https://your-zone-id.keycard.cloud
# From the application you create in the console (ClientSecret credentials)
WORKER_KEYCARD_CLIENT_ID=
WORKER_KEYCARD_CLIENT_SECRET=
# The Zone Provider resource the app depends on (exact string = token aud)
LEDGER_RESOURCE=urn:ledger:api

TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=keycard-temporal-demo
