# Where the MCP server is listening (its streamable-http endpoint).
MCP_URL=http://localhost:8100/mcp

# Model settings supplied by the instructor. Supported providers: openai, anthropic.
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
# Optional API base URL override; empty uses the selected provider's official API.
LLM_BASE_URL=
# Raw key for Exercise 01 only; secure exercises use the Keycard vault.
LLM_API_KEY=
# Exact model API resource identifier registered in Keycard.
LLM_RESOURCE=https://api.openai.com

# Anthropic only: an identity-linked key must name its workspace.
# Leave empty for OpenAI.
# Find it in the console (starts with wrkspc_). Leave empty for a workspace-scoped key.
LLM_WORKSPACE_ID=

# Issuer URL comes from the instructors; client id + secret come from the app
# you register in the workshop (Agent App - <Your name>).
KEYCARD_ISSUER=https://ho0llbxj2o7enn7l48tuzic25t.keycard.cloud
KEYCARD_CLIENT_ID=
KEYCARD_CLIENT_SECRET=
# Your own agent resource identifier from the same registration,
# urn:agent:resource:<your-github-handle>. The sign-in anchor for Exercise 03.
AGENT_RESOURCE=

# Browser origin; exact callback is this origin + /callback.
EXPENSE_DESK_ORIGIN=http://localhost:8400

# Shared automatic review worker; the instructor starts one per workshop room.
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=expense-desk-review
