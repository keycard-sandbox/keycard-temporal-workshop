#!/bin/bash
# ABOUTME: Track setup: write .env files from Instruqt secrets, then start
# Temporal and Expense Desk. The attendee tree is baked at /root/workshop.
set -euo pipefail

until [ -f /opt/instruqt/bootstrap/host-bootstrap-completed ]; do
    sleep 1
done

WORKSHOP=/root/workshop
ISSUER=https://ho0llbxj2o7enn7l48tuzic25t.keycard.cloud
ORIGIN="https://workshop-8400-${INSTRUQT_PARTICIPANT_ID:-local}.env.play.instruqt.com"

# TEMP(tmp.md): the three MCP values below default to `test-placeholder` so
# Expense Desk starts without the real secrets. Restore the defaults to empty
# (`:-}`) once the workshop secrets are set in Instruqt.
# Preserve existing files so a re-run never wipes Exercise 02 registration.
if [ ! -f "$WORKSHOP/agent/.env" ]; then
    cat > "$WORKSHOP/agent/.env" <<EOF
MCP_URL=http://localhost:8100/mcp
LLM_PROVIDER=openai
LLM_MODEL=gpt-5.4-mini
LLM_BASE_URL=
LLM_API_KEY=${KEYCARD_WORKSHOP_LLM_API_KEY:-}
LLM_RESOURCE=https://api.openai.com
LLM_WORKSPACE_ID=
EXPENSE_DESK_ORIGIN=${ORIGIN}
KEYCARD_ISSUER=${ISSUER}
KEYCARD_CLIENT_ID=
KEYCARD_CLIENT_SECRET=
AGENT_RESOURCE=
EOF
fi

if [ ! -f "$WORKSHOP/mcp-server/.env" ]; then
    cat > "$WORKSHOP/mcp-server/.env" <<EOF
LEDGER_URL=https://workshop-ledger-api.fly.dev
LEDGER_API_KEY=${KEYCARD_WORKSHOP_LEDGER_API_KEY:-test-placeholder}
KEYCARD_ISSUER=${ISSUER}
MCP_CLIENT_ID=${KEYCARD_WORKSHOP_MCP_CLIENT_ID:-test-placeholder}
MCP_CLIENT_SECRET=${KEYCARD_WORKSHOP_MCP_CLIENT_SECRET:-test-placeholder}
EOF
fi

# Exercise 04. Each sandbox has its own Temporal server, so the queue name
# from docs/06-temporal-local.md is safe to share.
if [ -d "$WORKSHOP/temporal" ] && [ ! -f "$WORKSHOP/temporal/.env" ]; then
    cat > "$WORKSHOP/temporal/.env" <<EOF
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=workshop-local
TEMPORAL_TASK_QUEUE=settlement-local
KEYCARD_ISSUER=${ISSUER}
WORKER_KEYCARD_CLIENT_ID=${KEYCARD_WORKSHOP_WORKER_CLIENT_ID:-}
WORKER_KEYCARD_CLIENT_SECRET=${KEYCARD_WORKSHOP_WORKER_CLIENT_SECRET:-}
LEDGER_RESOURCE=urn:ledger:api
EOF
fi

echo "export EXPENSE_DESK_ORIGIN=${ORIGIN}" >> /root/.bashrc
echo "${ORIGIN}/callback" > "$WORKSHOP/CALLBACK_URL.txt"

nohup temporal server start-dev \
    --ip 0.0.0.0 \
    --namespace workshop-local \
    --db-filename /root/temporal.db \
    --log-level warn \
    > /tmp/temporal-server.log 2>&1 &

temporal_ready() {
    temporal operator namespace describe -n workshop-local --address 127.0.0.1:7233 >/dev/null 2>&1
}
for _ in $(seq 1 60); do
    temporal_ready && break
    sleep 1
done
temporal_ready || { echo "==> Temporal dev server did not start."; tail -20 /tmp/temporal-server.log; exit 1; }

# Secrets may be blank until the workshop values are set in Instruqt. Keep
# the sandbox up so the editor and terminals still work.
workshop-services start \
    || echo "==> WARNING: Expense Desk isn't running. Fill in the .env values, then run: workshop-services start"

echo "==> Track setup complete. Expense Desk: ${ORIGIN}"
