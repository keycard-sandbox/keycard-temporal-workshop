# Where the ledger API is listening (its README runs it on 8300).
LEDGER_URL=http://localhost:8300

# The shared all-access key, the same value the ledger runs with as LEDGER_API_KEY.
# Every tool call forwards this key; the broken world has no per-caller identity.
LEDGER_API_KEY=

# All three come from the instructors: the issuer URL and the shared
# Expense MCP App's client id + secret (one app performs hop 2 for everyone).
KEYCARD_ISSUER=
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=
